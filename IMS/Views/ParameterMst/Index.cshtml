
@model IEnumerable<IMS_Model.CommonDropDown.ParameterMst>

<!DOCTYPE html>
<html>
<head>
    <style>

        td.details-control {
            background: url('http://www.datatables.net/examples/resources/details_open.png') no-repeat center center;
            cursor: pointer;
        }

        tr.shown td.details-control {
            background: url('http://www.datatables.net/examples/resources/details_close.png') no-repeat center center;
        }

        .boqmodal-content {
            background-color: #fefefe;
            margin: auto;
            padding: 20px;
            border: 1px solid #888;
            width: 70%;
            height: 60%;
            overflow-y: scroll;
            overflow-x: scroll;
        }

        .boqgrpmodal-content {
            background-color: #fefefe;
            margin: auto;
            padding: 20px;
            border: 1px solid #888;
            width: 65%;
            height: 60%;
            overflow-y: scroll;
            overflow-x: scroll;
        }

    </style>
</head>
<body>
    <div class="containers-style">
        <div class="card custom-card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-3">
                        <h5>Parameter Master List</h5>
                    </div>
                    <div class="col-md-9 text-right">
                        <a type="button" class="btn btn-secondary custombtn" asp-action="IMSSetting" asp-controller="Login" title="IMS Setting"><i class="fa fa-gear"></i></a>
                        <button type="button" onclick="AddGroup();" class="btn btn-success" style="width:88px" title="CreateParameterMst"><i class="fa fa-plus"></i></button>
                        <button type="button" onclick="AddSubGroup();" class="btn btn-outline-success" style="width:88px" title="CreateParameterValue"><i class="fa fa-plus"></i></button>
                        <button type="button" class="btn btn-outline-secondary" onclick="location.reload();" title="Refresh"> <i class="fa fa-refresh"></i></button>

                    </div>
                </div>

            </div>

            <div class="card-body">
                <table id="BoqTable" class="JqueryTable table-bordered tabletable-responsive-md" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:5%" id="srno">ParamId</th>
                            <th>Param Cd</th>
                            <th>Parameter Name</th>
                            <th>Parameter Description</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(m => m.ParamId))
                        {
                            <tr>

                                <td style="width:5%" class="details-control">@item.ParamId</td>
                                <td>@item.ParamCd</td>
                                <td>@item.ParamDispTxt</td>
                                <td>@item.ParamDesc</td>
                                <td>
                                    <a href="#" class="GrpEdit" title="Edit Group" data-dispcd="@item.ParamCd" data-dispdata="@item.ParamDispTxt" data-desdata="@item.ParamDesc" data-grpid="@item.ParamId"><i class='fa fa-edit'></i></a>
                                    &nbsp; &nbsp;&nbsp;
                                    <a href="#" class="DeleteGrp" title="Delete Group" data-dispcd="@item.ParamCd" data-dispdata="@item.ParamDispTxt" data-desdata="@item.ParamDesc" data-grpid="@item.ParamId"><i class="fa fa-trash" style="color:red"></i></a>

                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- Modal content 1-->
    <div id="Grouppop" class="modal">
        <div class="boqgrpmodal-content">
            <span class="close btnclose">&times;</span>
            <h3 style="text-align:center" id="createdis">
                Parameter Mst Creation
            </h3>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6 col-sm-6">
                        <span>
                            Param Cd
                            <input type="text" id="paramcd" class="form-control form-text" maxlength="50" required />
                            <input type="text" id="paramid" class="form-control form-text" hidden />

                        </span>
                    </div>

                    <div class="col-md-6 col-sm-6">
                        <span>
                            Param Display Text
                            <input type="text" id="grpdisp" class="form-control form-text" maxlength="50" required />
                            <input type="text" id="txtgrpid" class="form-control form-text" hidden />

                        </span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-sm-6" style="margin-top:5px">
                        <span>
                            Parameter Description
                            <input type="text" id="grpdesc" class="form-control form-text" maxlength="190" required />

                        </span>
                    </div>
                </div>
                <br />

                <div class="row col-md-12 col-sm-12">
                    <div class="col-md-2 col-sm-2">
                        <button type="button" id="AddnewGrp" visible class="btn btn-outline-success form-control" title="Save">Save</button>
                    </div>
                    <div class="col-md-2 col-sm-2">
                        <button type="button" id="UpdateGrp" visible class="btn btn-outline-primary form-control" title="Save">Update</button>
                    </div>
                    <div class="col-md-2 col-sm-2">
                        <button type="button" id="DeleteGrp" visible class="btn btn-outline-danger form-control" title="Save">Delete</button>
                    </div>

                </div>

            </div>

        </div>
    </div>


    <!-- Modal content 2-->
    <div id="SubGrouppop" class="modal">
        <div class="boqmodal-content">
            <span class="close btnclose">&times;</span>
            <h3 style="text-align:center" id="createdis">
                Parameter Value Creation
            </h3>


            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row col-md-12 col-sm-12" style="margin-top:10px;">
                <div class="col-md-6 col-sm-6">
                    <span>
                        Parameter Cd
                        <select id="grpname" class="form-control form-text custom-select">
                            <option>--Select--</option>
                            @foreach (var grpname in ViewBag.ParaMst)
                            {
                                <option value="@grpname.ParamCd">@grpname.ParamCd</option>
                            }
                        </select>
                        <input type="text" id="paravalid" class="form-control form-text" maxlength="50" hidden />
                    </span>
                </div>

                <div class="col-md-6 col-sm-6">
                    <span>
                        Param Value Text
                        <input type="number" id="grpsubname" class="form-control form-text" maxlength="2" required />
                    </span>
                </div>
            </div>
            <br />
            <div class="row col-md-12 col-sm-12">
                <div class="col-md-6 col-sm-6">
                    <span>
                        Param Value Display Text
                        <input type="text" id="grpsubdesc" class="form-control form-text" maxlength="190" required />
                    </span>
                </div>
            </div>
            <br />
            <div class="row col-md-12 col-sm-12">
                <div class="col-md-2 col-sm-2">
                    <button type="button" id="AddSubGrp" disabled class="btn btn-outline-success form-control" title="Save">Save</button>
                </div>
                <div class="col-md-2 col-sm-2">
                    <button type="button" id="UpdateSubGrp" disabled class="btn btn-outline-primary form-control" title="Save">Update</button>
                </div>


            </div>

        </div>
    </div>
</body>
</html>





<script>

    function AddGroup() {

        document.getElementById("Grouppop").style.display = "block";
        document.getElementById("UpdateGrp").style.visibility = "hidden";
        document.getElementById("DeleteGrp").style.visibility = "hidden";
    }

    $(".btnclose").click(function () {
        document.getElementById("Grouppop").style.display = "none";
        document.getElementById("SubGrouppop").style.display = "none";
        location.reload();
    });

</script>

@*Script For Group *@
<script>

    $(".GrpEdit").click(function () {
        var disp = $(this).data("dispdata");
        var desc = $(this).data("desdata");
        var paracd = $(this).data("dispcd");
        var Grpid = $(this).data("grpid");

        $("#grpdisp").val(disp);
        $("#grpdesc").val(desc);
        $("#paramcd").val(paracd);
        $("#paramid").val(Grpid);

        document.getElementById("Grouppop").style.display = "block";
        document.getElementById("AddnewGrp").style.visibility = "hidden";
        document.getElementById("DeleteGrp").style.visibility = "hidden";

    });


    $("#AddnewGrp").click(function () {

        var Paramcd = $("#paramcd").val();
        var grpdisp = $("#grpdisp").val();
        var grpdesc = $("#grpdesc").val();

        if (ValidationBOQgrp()) {
            Swal.fire({
                title: 'Are you sure? Do you want to Save?',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Save!'
            }).then((result) => {
                if (result.isConfirmed) {

                    $.ajax({
                        type: 'POST',
                        url: '/ParameterMst/GroupCreate',
                        data: { Paramcd: Paramcd, GrpDisc: grpdisp, GrpDec: grpdesc },
                        cache: false,
                        success: function (data) {
                            Swal.fire({
                                position: 'center',
                                text: data,
                                icon: 'success',
                                showConfirmButton: true,
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    $("#paramcd").val('');
                                    $("#grpdisp").val('');
                                    $("#grpdesc").val('');
                                    location.reload();
                                }
                            });
                            document.getElementById("Grouppop").style.display = "none";
                        },
                        error: function (xhr, status, error) {

                            alert(status);
                        }
                    });

                } else {

                    Swal.fire('BOQ Group has not been saved', '', 'info');
                    document.getElementById("Grouppop").style.display = "none";
                }
            });

        };

    });


    $("#UpdateGrp").click(function () {

        var Grpid = $("#paramid").val();
        var grpdisp = $("#grpdisp").val();
        var grpdesc = $("#grpdesc").val();
        var Paramcd = $("#paramcd").val();

        if (ValidationBOQgrp()) {
            Swal.fire({
                title: 'Are you sure? Do you want to Update?',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Update'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: 'POST',
                        url: '/ParameterMst/GroupEdit',
                        data: { Paramcd: Paramcd, GrpID: Grpid, GrpDisc: grpdisp, GrpDec: grpdesc },
                        cache: false,
                        success: function (data) {
                            Swal.fire({
                                position: 'center',
                                text: data,
                                icon: 'success',
                                showConfirmButton: true,
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    $("#paramcd").val('');
                                    $("#grpdisp").val('');
                                    $("#grpdesc").val('');
                                    $("#paramid").val('');
                                    location.reload();
                                }
                            });
                            document.getElementById("Grouppop").style.display = "none";
                        },
                        error: function (xhr, status, error) {

                            alert(status);
                        }
                    });
                } else {

                    Swal.fire('BOQ Group has not been saved', '', 'info');
                    document.getElementById("Grouppop").style.display = "none";
                }
            });
        };
    });


    $(".DeleteGrp").click(function () {

        var grpdisp = $(this).data("dispdata");
        var grpdesc = $(this).data("desdata");
        var Grpid = $(this).data("grpid");
        var Paramcd = $(this).data("dispcd");

        Swal.fire({
            title: 'Are you sure?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    type: 'POST',
                    url: '/ParameterMst/GroupDelete',
                    data: { Paramcd: Paramcd, GrpID: Grpid, GrpDisc: grpdisp, GrpDec: grpdesc },
                    cache: false,
                    success: function (data) {

                        Swal.fire({
                            position: 'center',
                            icon: 'success',
                            text: data,
                            icon: 'success',
                            showConfirmButton: true,

                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload();
                            };
                        });
                    },

                });

            }
        })
    });
</script>



@*Script For Sub-Group *@
<script>

    function AddSubGroup() {

        document.getElementById("SubGrouppop").style.display = "block";
        document.getElementById("AddSubGrp").disabled = false;

    };

    $("#AddSubGrp").click(function () {

        var name = $("#grpname :selected").val();
        var subdisname = $("#grpsubname").val();
        var subname = $("#grpsubdesc").val();

        if (ValidationBOQsubgrp()) {

            Swal.fire({
                title: 'Are you sure? Do you want to Save?',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Save!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: 'POST',
                        url: '/ParameterMst/InsertSubGrp',
                        data: { GrpName: name, GrpSubDis: subname, GrpSubName: subdisname },
                        cache: false,
                        success: function (data) {
                            Swal.fire({
                                position: 'center',
                                text: data,
                                icon: 'success',
                                showConfirmButton: true,
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    $("#grpname").val('');
                                    $("#grpsubname").val('');
                                    $("#grpsubdesc").val('');
                                    location.reload();
                                }
                            });
                            document.getElementById("SubGrouppop").style.display = "none";
                        },
                        error: function (xhr, status, error) {

                            alert(status);
                        }
                    });
                } else {

                    Swal.fire('BOQ Sub-Group has not been saved', '', 'info');
                    document.getElementById("SubGrouppop").style.display = "none";
                }
            });
        };

    });

    $("#UpdateSubGrp").click(function () {

        var name = $("#grpname :selected").val();
        var subdisname = $("#grpsubname").val();
        var subname = $("#grpsubdesc").val();
        var subgrpid = $("#paravalid").val();

        if (ValidationBOQsubgrp()) {

            Swal.fire({
                title: 'Are you sure? Do you want to Update?',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Update'
            }).then((result) => {


                if (result.isConfirmed) {

                    $.ajax({
                        type: 'POST',
                        url: '/ParameterMst/UpdateSubGrp',
                        data: { SubGrpId: subgrpid, GrpName: name, GrpSubDis: subname, GrpSubName: subdisname },
                        cache: false,
                        success: function (data) {
                            Swal.fire({
                                position: 'center',
                                text: data,
                                icon: 'success',
                                showConfirmButton: true,
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload();
                                }
                            });
                            $("#SubGrouppop").hide();
                        },
                        error: function (xhr, status, error) {
                            alert(status);
                        }
                    });
                } else {

                    Swal.fire('BOQ Sub-Group has not been Updated', '', 'info');
                    $("#SubGrouppop").hide();
                }
            });
        };

    });
</script>



<script>

    $(document).ready(function () {
        let table = new DataTable('#BoqTable');

        $('#BoqTable').on('click', 'td.details-control', function () {
            var tr = $(this).closest('tr');

            var row = table.row(tr);
            var rowData = row.data();

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
            } else {
                var id = rowData[0];

                $.ajax({
                    url: '/ParameterMst/ChildDatabyID',
                    type: 'POST',
                    data: { Id: id },
                    success: function (response) {
                        debugger
                        var detailsRow = formatDetails(response);
                        row.child(detailsRow).show();
                        tr.addClass('shown');
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX request error:", error);
                    }
                });
            }
        });
    });

    function formatDetails(data) {
        var html = '<table class="table-bordered tabletable-responsive-md ChildGrid" style="width:100%"><thead><tr><th>Sub Grp ID</th><th>Sub Grp Disp</th><th>Sub Grp Desc</th><th>Tally Ledger</th><th>Action</th></tr></thead><tbody>';

        for (var i = 0; i < data.length; i++) {
            html += '<tr>';
            html += '<td>' + data[i].paramValId + '</td>';
            html += '<td>' + data[i].paramCd + '</td>';
            html += '<td>' + data[i].paramValDispTxt + '</td>';
            html += '<td>' + data[i].paramValueTxt + '</td>';

            html += '<td><a href="#" class="SubGrpEdit" title="Edit Sub Group" data-subgrpid="' + data[i].paramValId + '"><i class="fa fa-edit"></i></a>  &nbsp; &nbsp;&nbsp;  <a href="#" class="SubGrpDelete" title="Delete Sub Group" data-subgrpid="' + data[i].paramValId + '"><i class="fa fa-trash" style="color:red"></i></a></td>';
            html += '</tr>';

        }
        html += '</tbody></table>';
        return html;
    }


    $('#BoqTable').on('click', '.SubGrpEdit', function (event) {
        event.preventDefault();

        var subGrpId = $(this).data('subgrpid');
        $.ajax({
            type: 'POST',
            url: '/ParameterMst/GetSubGroupData',
            data: { SubGrpId: subGrpId },
            success: function (data) {
                debugger
                document.getElementById("SubGrouppop").style.display = "block";
                $('#grpname').val(data[0].paramCd);
                $('#grpsubname').val(data[0].paramValueTxt);
                $('#grpsubdesc').val(data[0].paramValDispTxt);
                $('#paravalid').val(data[0].paramValId);
            },

        });
        document.getElementById("UpdateSubGrp").disabled = false;
    });


    $('#BoqTable').on('click', '.SubGrpDelete', function (event) {
        event.preventDefault();

        var subtextid = $(this).data('subgrpid');

        Swal.fire({
            title: 'Do you want to Delete ?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Delete it!'
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    type: 'POST',
                    url: '/ParameterMst/DeleteSubGrp',
                    data: { SubGrpId: subtextid },
                    cache: false,
                    success: function (data) {
                        Swal.fire({
                            position: 'center',
                            text: data,
                            icon: 'success',
                            showConfirmButton: true,
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.reload();
                            }
                        });

                    },
                    error: function (xhr, status, error) {
                        alert(status);
                    }
                });
            } else {

                Swal.fire('BOQ Item has not been Deleted', '', 'info');

            }
        });

    });

</script>



<script>

    function ValidationBOQgrp() {

        var grpdisp = $("#grpdisp").val();
        var grpdesc = $("#grpdesc").val();


        if (grpdisp == null || grpdisp == '') {
            alert("Param Display Text Can not be left blank", this);
            return false;
        }

        if (grpdesc == null || grpdesc == '') {
            alert("Parameter Description Can not be left blank", this);
            return false;
        }

        if (grpdesc == grpdisp) {
            alert("Param Display Text And Parameter Description Can not be Same", this);
            return false;
        }
        return true;
    }


    function ValidationBOQsubgrp() {

        var name = $("#grpname").val();
        var subname = $("#grpsubname").val();
        var subdisname = $("#grpsubdesc").val();


        if (name == "--Select--") {
            alert("Select Parameter Cd ", this);
            return false;
        }


        if (subname == null || subname == '') {
            alert("Parameter Value Text Can not be left blank", this);
            return false;
        }

        if (subdisname == null || subdisname == '') {
            alert("Parameter Value Description Can not be left blank", this);
            return false;
        }

        if (subname == subdisname) {
            alert("Parameter Value And Parameter Value Description Can not be Same", this);
            return false;
        }
        return true;

    }

</script>


<script src="~/js/code.jquery.com_ui_1.12.1_jquery-ui.js"></script>
<link href="~/css/code.jquery.com_ui_1.12.1_themes_base_jquery-ui.css" rel="stylesheet" />