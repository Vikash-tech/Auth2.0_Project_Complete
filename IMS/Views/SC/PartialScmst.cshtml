</table>
<script>
    //for Query table
    $(document).ready(function () {
        $('#tblMstlist').DataTable();
    });

    //Send data into Textbox
    $(".EditMst").click(function () {

        var reg = $(this).data("regno");
        var name = $(this).data("name");
        var compy = $(this).data("compy");
        var cinno = $(this).data("cinnum");
        var pan = $(this).data("pan");
        var regstate = $(this).data("state");
        var gststatus = $(this).data("gststatus");
        var scgst = $(this).data("scgst");
        var scpf = $(this).data("scpf");
        var scesi = $(this).data("scesi");
        var bank = $(this).data("bank");
        var bankac = $(this).data("bankac");
        var bankifsc = $(this).data("bankifsc");
        var msmes = $(this).data("memsst");
        var register = $(this).data("register");
        var msmeturn = $(this).data("msmeturn");
        var finyear = $(this).data("finyear");
        var site = $(this).data("reqsite");
        var Category = $(this).data("category");

        var PanAttid = $(this).data('panattach');
        var GstAttid = $(this).data('gstattach');
        var PfAttid = $(this).data("pfattach");
        var EsicAttid = $(this).data("esicattach");
        var CheqAttid = $(this).data("chequeattach");
        var MandAttid = $(this).data("mandateattach");
        var MsmeAttid = $(this).data("msmeattach");
        var SCAttid = $(this).data("scattach");

        $("#SCRegNo").val(reg);
        $("#SCName").val(name);
        $("#compy").val(compy);
        $("#txtuni").val(cinno);
        $("#Panno").val(pan);
        $("#State").val(regstate);
        $("#Gst").val(gststatus);
        $("#gstno").val(scgst);
        $("#pfno").val(scpf);
        $("#esicno").val(scesi);
        $("#banks").val(bank);
        $("#ACno").val(bankac);
        $("#Ifsc").val(bankifsc);
        $("#Msmestatus").val(msmes);
        $("#regno").val(register);
        $("#turnover").val(msmeturn);
        $("#typeEnterprise").val(Category);


        $("#finan").val(finyear);
        $("#Sitelist").val(site);

        $("#Panattchid").val(PanAttid);

        //for Rending list Partial view

        var tempscid = $(this).data('tempsc');

        $.ajax({
            type: 'GET',
            url: '/SC/AddressMst',
            data: { Tempscid: tempscid },
            success: function (result) {
                $('#address').html(result);
            }
        });

        $.ajax({
            type: 'GET',
            url: '/SC/EquipmentMst',
            data: { eqipid: tempscid },
            success: function (result) {
                $('#PartialEquipment').html(result);
            }
        });

        $.ajax({
            type: 'GET',
            url: '/SC/AssociateMst',
            data: { eqipid: tempscid },
            success: function (result) {
                $('#PartialAssoci').html(result);
            }
        });

        $.ajax({
            type: 'GET',
            url: '/SC/ExperienceMst',
            data: { eqipid: tempscid },
            success: function (result) {
                $('#PartialExp').html(result);
            }
        });


        $.ajax({
            type: 'GET',
            url: '/SC/Attach',
            data: {
                SCPANAttach: PanAttid,
                SCGSTAttach: GstAttid,
                SCPFAttach: PfAttid,
                SCESIAttach: EsicAttid,
                SCCHQAttac: CheqAttid,
                MandateAttach: MandAttid,
                MSMEAttach: MsmeAttid,
                SCAttch: SCAttid
            },
            success: function (result) {
                $('#AttachPartial').html(result);
            }
        });

        var Addmodal = document.getElementById("btnpedSCopen");
        Addmodal.style.display = "none";
    });
</script>


