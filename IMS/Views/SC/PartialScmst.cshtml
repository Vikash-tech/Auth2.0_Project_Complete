                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.SCExpConstInd)
                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.Remarks)
                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.SCCNTDesig)
                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.MSMEStatus)
                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.RegisterNo)
                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.ValidUpto)
                </td>
                <td style="display:none">
                    @Html.DisplayFor(modelItem => item.MSMETurnOver)
                </td>
                <td style="display:none">
