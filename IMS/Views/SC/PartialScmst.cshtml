                       data-finyear="@item.FinanceYear" data-cinnum="@item.SCCIN" data-reqsite="@item.SiteCode" data-category="@item.Category"

                       data-panattach="@item.SCPANAttach" data-gstattach="@item.SCGSTAttach" data-pfattach="@item.SCPFAttach" data-esicattach="@item.SCESIAttach"
