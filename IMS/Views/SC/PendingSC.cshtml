@model IEnumerable<IMS_Model.SC.SCCreation.SCMstReq>

<table id="tblPendSClist" class="JqueryTable table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>Site</th>
            <th>SC Name</th>
            <th>GST Status</th>
            <th>PAN No.</th>
            <th>SC Status</th>
            <th style="width:10%;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ReqSite</td>
                <td>@item.SCName</td>
                <td>@item.SCGSTStatusvar</td>
                <td>@item.SCPAN</td>
                <td>@item.SCStatusvar</td>
                <td style="width:10%;">
                    <a href="@Url.Action("SCIndex", "sc", new {
                        @class = "btnRead",
                        Data = 1,
                        Tempscid = item.TmpScId,
                        SCPANAttach = item.SCPANAttach,
                        SCGSTAttach = item.SCGSTAttach,
                        SCPFAttach = item.SCPFAttach,
                        SCESIAttach = item.SCESIAttach,
                        SCCHQAttac = item.SCCHQAttac,
                        MandateAttach = item.MandateAttach,
                        MSMEAttach = item.MSMEAttach,
                        SCAttch = item.SCAttch
                    })">
                        <i class="fa fa-edit"></i>
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        new DataTable("#tblPendSClist", {

            dom: 'Bfrtip',
            fixedheader: true,
            paging: true,
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa-solid fa-file-excel"></i>',
                    titleAttr: 'Excel',
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf"></i>',
                    titleAttr: 'PDF',
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'print',
                    text: '<i class="fa-solid fa-print"></i>',
                    titleAttr: 'Print',
                    exportOptions: {
                        columns: ':visible'
                    }
                },
                {
                    extend: 'colvis',
                    text: '<i class="fa-solid fa-gears"></i>',
                    titleAttr: 'Custom Column',
                },
            ]

        });
    });
</script>
