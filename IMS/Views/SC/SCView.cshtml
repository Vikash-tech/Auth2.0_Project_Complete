    });

</script>


<script>
    $("#Verification").click(function () {
       // var scstatus = parseInt($("#scstatus").val()) + 1;
        var scstatus = $("#scstatus").val();
        var tempid = $("#tmpscid").val();

        $.ajax({
            type: 'POST',
            url: '/SC/Verification',
            data: { Tempid: tempid, SCStatus: scstatus },
            cache: false,
            success: function (data) {

             $("#scstatus").val('');
             $("#tmpscid").val('');  
             location.reload();
            },
        });
    });
</script>


