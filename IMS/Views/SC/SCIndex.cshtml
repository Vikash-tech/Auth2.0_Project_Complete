<script>
    function ValidationSC() {

        var site = $("#Sitelist").val();
        var scname = $("#SCName").val();
        var compty = $("#compy :selected").val();
        var comptyid = $("#compy").val();
        var ccin = $("#txtuni").val();
        var pan = $("#Panno").val();
        var sTATES = $("#State :selected").text();
        var sTATEScode = $("#State :selected").val();
        var gststatus = $("#Gst").val();
        var gstno = $("#gstno").val();
        var memsstatus = $("#Msmestatus").val();
        var enterprise = $("#typeEnterprise").val();
        var reg = $("#regno").val();
        var pfno = $("#pfno").val();
        var esicno = $("#esicno").val();
        var gstsubstring = gstno.substring(0, 2);
        var panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;

        var attchdrop = $("#fileNameInput option:selected").text();
        var ESIC = $("#fileNameInput option:selected").text();


        if (site == null || site == '') {
            alert("Please Select Site ", this);
            return false;
        }


        if (scname == null || scname == "") {
            alert("SC Name Can Not Be Left Blank", this);
            return false;
        }

        if (compty == "-1") {
            alert("Please Select Company Type", this);
            return false;
        }

        if (comptyid == 1 || comptyid == 2 || comptyid == 3) {
            if (ccin == null || ccin == "") {
                alert("CIN/LLPIN No Can not be left blank", this);
                return false;
            }
        }

        if (pan == null || pan == "") {
            alert("PAN no Can not be left blank", this); return false;
        }

        if (panPattern.test(pan)) {

        }
        else {
            alert("Invalid PAN card number. Enter in Capital Letter", this); return false;

        }

        if (sTATES == "-1") {
            alert("Please Select State", this);
            return false;
        }

        if (gststatus == "-1") {
            if (gstno == null || gstno == "") {
                alert("GSIN No. Can Not Be Left Blank", this);
                return false;
            }
        }

        if (gststatus <= 4)  // check length pending
        {
            if (gstno.Length > 15 || gstno.Length < 15) {
                alert("GST No. Length Can not be more or less than 15", this);
                return false;
            }
        }

        if (gststatus < 4) {
            if (gstno == null || gstno == "") {
                alert("GSIN No. Can Not Be Left Blank", this);
                return false;
            }

            if (sTATEScode != gstsubstring) {
                alert('GSIN Registered State Does Not Match With GSTIN No.');
                return false;
            }
        }

        if (memsstatus == "-1") {
            alert("Please Select MSME Status", this); return false;
        }

        if (memsstatus == 1) {
            if (enterprise == "-1") {
                alert("Type of Enterprise Can not be Blank", this); return false;
            }
            if (reg == null || reg == "") {
                alert("Regn. Certificate No Can not be Blank", this); return false;
            }
        }
        return true;
    }

    var Activestatus = 0;
    var scstatus = 0;
