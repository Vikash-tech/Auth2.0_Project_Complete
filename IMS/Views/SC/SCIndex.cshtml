@model IMS_Model.SC.SCCreation.VmSC
<!DOCTYPE html>
<html>
<head>
    <style>

        #done {
            /* background: #000 url('loader.gif') no-repeat center;*/
            background: #FFFF url('ezgif.com-gif-maker.webp') no-repeat center;
            background-size: 10%;
            height: 100%;
            width: 100%;
            position: absolute;
            z-index: 100;
        }
    </style>

    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["Success"]';
            var errorMessage = '@TempData["Error"]';

            if (successMessage !== "") {
                alert(successMessage);
            } else if (errorMessage !== "") {
                alert(errorMessage);
            }
        });
    </script>
</head>

<body>
    <div class="containers-style">
        <form id="Sendata" method="post">
            <div class="card .custom-card">
                <div class="card-header">

                    <div class="row">
                        <div class="col-md-3">
                            <h5>Sub Contractor Creation Request</h5>
                        </div>
                        <div class="col-md-9 text-right">

                            <a type="button" id="btnpedSC" class="btn btn-outline-dark custombtn" asp-controller="SC" asp-action="Index" title="Back"><i class="fa fa-backward"></i></a>
                            @if (Model.scmst != null)
                            {
                                @if (Model.scmst.SCStatus != 0)
                                {
                                    @if (Model.scmst.SCStatus == 1)
                                    {
                                        <button type="button" onclick="UpdateSC();" class="btnUpdate btn btn-outline-primary custombtn" title="Update"><i class="fa fa-random"></i></button>
                                        <button type="button" id="Verification" class="btnPMVerify btn btn-success custombtn" title="Verification"><i class="fa fa-check"></i></button>
                                        <button type="button" id="Reject" class="btnCancel btn btn-danger custombtn" title="Reject"><i class="fa fa-ban"></i></button>
                                    }
                                    @if (Model.scmst.SCStatus == 2)
                                    {
                                        <button type="button" id="Approval" class="btnApprove btn btn-success custombtn" title="Approval"><i class="fa fa-check"></i></button>
                                        <button type="button" id="Reject" class="btnCancel btn btn-danger custombtn" title="Reject"><i class="fa fa-ban"></i></button>
                                    }
                                }
                            }
                            else
                            {
                                <button type="button" class="btnAdd btn btn-success custombtn" id="savebtn" onclick="SaveButn();" title="Save"><i class="fa fa-save"></i></button>
                            }
                            <button type="button" class="btn btn-outline-secondary custombtn" id="reload" title="Clear Data"><i class="fa fa-refresh"></i></button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row" style="margin-top:-15px;">
                        <div class="col-md-2 col-sm-2">
                            <span>
                                SC Reg No
                                <input type="hidden" asp-for="scmst.TmpScId" />
                                <input type="hidden" asp-for="scmst.SCStatus" />
                                <input type="hidden" asp-for="scmst.ReqSite" />
                                <input type="text" asp-for="scmst.ScRegNo" class="form-control form-text" id="SCRegNo" placeholder="SC Reg No" disabled />
                            </span>
                        </div>

                        <div class="col-md-8 col-sm-8">
                            <span>
                                SC Name<span class="text-danger">*</span>
                                <input type="text" asp-for="scmst.SCName" class="form-control form-text" id="SCName" style="text-transform:uppercase" placeholder="Sub-Contractor Name" maxlength="50" />
                            </span>
                        </div>

                        <div class="col-md-2 col-sm-2">
                            <span>
                                Company Type<span class="text-danger">*</span>
                                <select asp-for="scmst.SCCompType" class="form-control form-text custom-select" asp-items="Model.Compty" id="compy">
                                    <option value="-1">--Select--</option>
                                </select>
                            </span>
                        </div>
                    </div>

                    <div class="tabset" style="margin-top:15px;">
                        <!-- Tab 1 -->
                        <input type="radio" name="tabset" id="tab1" aria-controls="basic" checked>
                        <label for="tab1">Address Details</label>
                        <!-- Tab 2 -->
                        <input type="radio" name="tabset" id="tab2" aria-controls="statutory">
                        <label for="tab2">Statutory Details</label>
                        <!-- Tab 3 -->
                        <input type="radio" name="tabset" id="tab3" aria-controls="bank">
                        <label for="tab3">Bank Details / TurnOver</label>
                        <!-- Tab 4 -->
                        <input type="radio" name="tabset" id="tab4" aria-controls="equip">
                        <label for="tab4">Equipment</label>
                        <!-- Tab 5 -->
                        <input type="radio" name="tabset" id="tab5" aria-controls="associ">
                        <label for="tab5">Associate Company</label>
                        <!-- Tab 6 -->
                        <input type="radio" name="tabset" id="tab6" aria-controls="exp">
                        <label for="tab6">Experience</label>
                        <!-- Tab 7 -->
                        <input type="radio" name="tabset" id="tab7" aria-controls="attach">
                        <label for="tab7">Attachment</label>


                        <div class="tab-panels">

                            <div id="basic" class="tab-panel">

                                <div class="row" style="margin-top:-25px;">
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Address Line 1<span class="text-danger">*</span>
                                            <input type="text" class="form-control form-text" id="Address1" maxlength="100" />
                                            <input type="text" class="form-control form-text" id="txtsrno" hidden />
                                            <input type="text" class="form-control form-text" id="txtaddid" hidden />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Address Line 2
                                            <input type="text" class="form-control form-text" id="Address2" name="Addres2" maxlength="100" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Address Line 3
                                            <input type="text" class="form-control form-text" id="Address3" name="Addres3" maxlength="100" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            City/Tehsil
                                            <input type="text" class="form-control form-text" id="City" name="City/Tehsil" maxlength="50" />
                                        </span>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:5px">
                                    <div class="col-md-1 col-sm-1 ">
                                        <span>
                                            Country
                                            <select id="Option" class="form-control form-text" name="Country">
                                                <option value="India">India</option>
                                            </select>
                                        </span>
                                    </div>

                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Pincode
                                            <input type="number" class="form-control form-text" id="Pincode" maxlength="6" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Phone No
                                            <input type="tel" class="form-control form-text" id="Phone" pattern="^[0-9]{0,10}$" maxlength="10" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3 ">
                                        <span>
                                            Fax No
                                            <input type="number" class="form-control  form-text" id="fax" name="Fax No" maxlength="10" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3 ">
                                        <span>
                                            Name of Contact person
                                            <input type="text" class="form-control form-text" id="contper" maxlength="50" />
                                        </span>
                                    </div>
                                </div>
                                <div class="clearfix">
                                </div>
                                <div class="row " style="margin-top:5px">
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Designation
                                            <input type="text" class="form-control form-text" id="designat" name="Designation" maxlength="50" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Mobile No<span class="text-danger">*</span>
                                            <input type="number" class="form-control  form-text" id="mobile" name="Mobile No" maxlength="10" />
                                        </span>
                                    </div>
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Email Id
                                            <input type="email" class="form-control form-text" id="emails" name="Email Id" maxlength="100" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            <br />
                                            <button class="btn btn-success" id="AddressADD" title="Add Address" onclick="AddAddress();"><i class="fa fa-plus"></i></button>
                                            <button class="btn btn-primary" disabled title="Update Address" id="Addressupdate"><i class="fa fa-random"></i></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="clearfix"></div>

                                <hr />
                                <div class="row" style="margin-top:5px;">
                                    <div id="address" class="col-md-12 col-sm-12">
                                    </div>
                                </div>
                            </div>

                            <div id="statutory" class="tab-panel">
                                <div class="row" style="margin-top:-25px;">
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Unique CIN/LLPIN No.
                                            <input type="text" id="txtuni" asp-for="scmst.SCCIN" class="form-control form-text" pattern="[0-9A-Z]{15}" maxlength="25" required />
                                        </span>
                                    </div>
                                    <div class="col-md-3 col-sm-3 ">
                                        <span>
                                            PAN No.
                                            <input type="text" asp-for="scmst.SCPAN" id="Panno" class="form-control form-text" maxlength="10" />
                                        </span>
                                    </div>
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            GST Registeration Status
                                            <select id="Gst" asp-for="scmst.SCGSTStatus" asp-items="Model.GST" class="form-control form-text custom-select">
                                                <option value="-1">--Select--</option>
                                            </select>
                                        </span>
                                    </div>
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            GST Regd State
                                            <select asp-for="scmst.SCRegdState" class="form-control form-text custom-select" asp-items="Model.Statelist" id="State">
                                                <option value="-1">--Select--</option>
                                            </select>
                                        </span>
                                    </div>
                                </div>

                                <div class="row" style="margin-top:5px">
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            GSTIN No.
                                            <input type="text" asp-for="scmst.SCGST" id="gstno" class="form-control form-text" pattern="[0-9A-Z]{15}" maxlength="20" style="align-content:center" />
                                        </span>
                                    </div>

                                    <div class="col-md-2 col-sm-2">
                                        MSME Status
                                        <select id="Msmestatus" asp-for="scmst.MSMEStatus" class="form-control form-text custom-select" asp-items="Model.Msme">
                                            <option value="-1">--Select--</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 col-sm-2 ">
                                        <span>
                                            Type of Enterprise
                                            <select id="typeEnterprise" asp-for="scmst.Category" class="form-control form-text custom-select" asp-items="Model.Enterprise">
                                                <option value="-1">--Select--</option>
                                            </select>
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Regn. Certificate No
                                            <input type="text" id="regno" asp-for="scmst.RegisterNo" class="form-control form-text" style="align-content:center" maxlength="50" />
                                        </span>
                                    </div>

                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            PF Regd. No.
                                            <input type="text" asp-for="scmst.SCPF" class="form-control form-text" id="pfno" pattern="[A-Z]{2}/[A-Z]{3}/[0-9]{5}" maxlength="25" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            ESIC Regn. No.
                                            <input type="text" asp-for="scmst.SCESI" class="form-control form-text" id="esicno" pattern="[0-9]{17}" maxlength="25" />
                                        </span>
                                    </div>

                                </div>
                                <div class="clearfix"></div>
                                @*
                                <div class="row"style="margin-top:5px">

                                <div class="col-md-3 col-sm-3">
                                <span>
                                Financial Year
                                <input type="text" id="finan" class="form-control form-text" style="align-content:center" disabled/>
                                </span>
                                </div>
                                <div class="col-md-3 col-sm-3">
                                <span>
                                Turn Over(Rs.)
                                <input type="text" id="turnover" class="form-control form-text" style="align-content:center" disabled/>
                                </span>
                                </div>
                                </div>*@
                            </div>

                            <div id="bank" class="tab-panel">
                                <div class="row" style="margin-top: -25px;">
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Site
                                            <select class="form-control form-text custom-select" id="sitelocation">
                                                <option value="-1">--Select--</option>
                                                <option value="MUMB">MUMB</option>
                                            </select>
                                        </span>
                                    </div>
                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            Bank Name<span class="text-danger">*</span>
                                            <select asp-for="scmst.SCBANK" class="form-control form-text custom-select" id="banks" asp-items="Model.Banklists">
                                                <option value="-1">--Select--</option>
                                            </select>
                                        </span>
                                    </div>
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            A/C No<span class="text-danger">*</span>
                                            <input type="number" asp-for="scmst.SCBANKAcNo" class="form-control form-text" id="ACno" style="align-content:center" maxlength="20" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            IFSC Code<span class="text-danger">*</span>
                                            <input type="text" asp-for="scmst.SCBANKIFSC" class="form-control form-text" id="Ifsc" style="text-transform:uppercase" maxlength="15" />
                                        </span>
                                    </div>
                                </div>

                                <div class="break" style="margin-top:10px; background-color: lightcyan">
                                    <span>
                                        TurnOver
                                    </span>
                                </div>

                                <div class="row" style="margin-top:5px">
                                    <div class="col-md-2 col-sm-2 ">
                                        <span>
                                            Exp. In Industry
                                            <input type="text" asp-for="scmst.SCExpConstInd" class="form-control  form-text" id="industry" style="align-content:center" maxlength="25" />
                                        </span>
                                    </div>
                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            Referred By
                                            <input type="text" asp-for="scmst.ReferredBy" class="form-control  form-text" id="referred" style="align-content:center" maxlength="25" />
                                        </span>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <span>
                                            Spl. Notes (if any)
                                            <input type="text" asp-for="scmst.Remarks" class="form-control  form-text" id="splnote" style="align-content:center" maxlength="14" />
                                        </span>
                                    </div>
                                </div>

                                <div class="row" style="margin-top:5px">
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Year 1
                                            <input type="number" asp-for="scmst.Year1" id="year1" class="form-control  form-text" style="align-content:center" maxlength="5" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Turnover
                                            <input type="number" asp-for="scmst.Turnover1" id="turnover1" class="form-control  form-text" style="align-content:center" maxlength="8" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Year 2
                                            <input type="number" asp-for="scmst.Year2" id="year2" class="form-control  form-text" style="align-content:center" maxlength="5" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2 ">
                                        <span>
                                            Turnover
                                            <input type="number" asp-for="scmst.Turnover2" id="turnover2" class="form-control form-text" style="align-content:center" maxlength="8" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Year 3
                                            <input type="number" asp-for="scmst.Year3" id="year3" class="form-control  form-text" style="align-content:center" maxlength="5" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Turnover
                                            <input type="number" asp-for="scmst.Turnover3" id="turnover3" class="form-control form-text" style="align-content:center" maxlength="8" />
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div id="equip" class="tab-panel">
                                <div class="row" style="margin-top:-25px;">
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            Equipment Description
                                            <input type="text" id="equipdesc" class="form-control form-text" maxlength="50">
                                            <input type="text" id="textequisrno" hidden class="form-control form-text">
                                            <input type="text" id="textequiid" hidden class="form-control form-text">
                                        </span>
                                    </div>

                                    <div class="col-md-2  col-sm-2">
                                        <span>
                                            Make
                                            <input type="text" id="make" class="form-control form-text" maxlength="50">
                                        </span>
                                    </div>

                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            Model
                                            <input type="text" id="model" class="form-control form-text" maxlength="50">
                                        </span>
                                    </div>

                                    <div class="col-md-1 col-sm-1">
                                        <span>
                                            Number
                                            <input type="number" id="number" class="form-control form-text" maxlength="25">
                                        </span>
                                    </div>
                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            <br />
                                            <button type="button" class="btn btn-success" onclick="Addequipment();" id="equiadd"><i class="fa fa-plus"></i></button>
                                            <button type="button" class="btn btn-primary" id="equipUpdate" disabled><i class="fa fa-random"></i></button>
                                        </span>

                                    </div>
                                </div>

                                <div class="row" style="margin-top:5px;padding:5px;">

                                    <div id="PartialEquipment" class="col-md-12 ">
                                    </div>
                                </div>
                            </div>

                            <div id="associ" class="tab-panel">
                                <div class="row" style="margin-top:-25px;">
                                    <div class="col-md-8 col-sm-8">
                                        <span>
                                            Associate Company Name
                                            <input type="text" id="assoname" class="form-control form-text" maxlength="50">
                                            <input type="text" id="txtassSrno" class="form-control form-text" hidden>
                                            <input type="text" id="txtcmpid" class="form-control form-text" hidden>
                                        </span>
                                    </div>

                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            <br />
                                            <button type="button" class="btn btn-success" id="assoadd" onclick="Assocompy();"><i class="fa fa-plus"></i></button>
                                            <button type="button" class="btn btn-primary" id="AssoUpdate" disabled>  <i class="fa fa-random"></i></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="clearfix"></div>

                                <div class="row" style="margin-top:5px;padding:5px;">
                                    <div id="PartialAssoci" class="col-md-12">
                                    </div>
                                </div>
                            </div>

                            <div id="exp" class="tab-panel">
                                <div class="row" style="margin-top:-25px;">

                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            Project Location
                                            <input type="text" id="site" class="form-control form-text" maxlength="25">
                                            <input type="text" class="form-control form-text" hidden id="txtexpsrno" />
                                            <input type="text" class="form-control form-text" hidden id="txtwoid" />
                                        </span>
                                    </div>

                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            Project Name
                                            <input type="text" id="projname" class="form-control form-text" maxlength="100">
                                        </span>
                                    </div>


                                    <div class="col-md-1 col-sm-1">
                                        <span>
                                            Wo Value
                                            <input type="number" id="wovalue" name='value' class="form-control form-text" maxlength="15">
                                        </span>
                                    </div>


                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            <br />
                                            <button type="button" class="btn btn-success" id="expadd" onclick="Experience();"><i class="fa fa-plus"></i></button>
                                            <button type="button" class="btn btn-primary" disabled id="Experienceupdate"><i class="fa fa-random"></i></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:5px">
                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            Project Client
                                            <input type="text" id="client" class="form-control form-text" maxlength="100">
                                        </span>
                                    </div>

                                    <div class="col-md-4 col-sm-4">
                                        <span>
                                            State
                                            <input type="text" id="state" class="form-control form-text" maxlength="25">
                                        </span>
                                    </div>
                                </div>

                                <div class="row" style="margin-top:5px">
                                    <div class="col-md-8 col-sm-8">
                                        <span>
                                            WO Description
                                            <textarea maxlength="500" rows="2" cols="30" class="form-control form-text" id="wodesc" style="resize:none" form="WOdescription"></textarea>
                                        </span>
                                    </div>
                                </div>
                                <div class="clearfix"> </div>

                                <div class="row" style="margin-top:5px ; padding: 5px">
                                    <div id="PartialExp" class="col-md-12">
                                    </div>
                                </div>
                            </div>

                            <div id="attach" class="tab-panel">

                                <div class="row" style="margin-top:-25px;">
                                    <div class="col-md-2 col-sm-2">
                                        <span>
                                            File Name
                                            <select id="fileNameInput" class="custom-select" asp-items="Model.Attachfilepara">
                                                <option value="-1">--Select--</option>
                                            </select>
                                            <input type="hidden" id="Srnotext" />
                                            <input type="hidden" id="FileNametext" />
                                            <input type="hidden" id="AttachIDtext" />
                                        </span>
                                    </div>
                                    <div class="col-md-2 col-sm-2">

                                        <span>
                                            File Attach
                                            <input type="file" ID="pdfInput" class="form-control form-text" accept=".pdf" />
                                        </span>
                                    </div>

                                    <div class="col-md-3 col-sm-3">
                                        <span>
                                            <br />
                                            <button type="button" ID="AdduploadButton" onclick="Uploadfile();" class="btn btn-success"><i class="fa fa-plus"></i></button>
                                            <button type="button" ID="UpdateAttachButton" disabled onclick="UpdateUploadfile();" class="btn btn-primary"><i class="fa fa-random"></i></button>
                                        </span>
                                    </div>

                                    <div class="row" style="margin-top:5px;">
                                        <div id="AttachPartial" class="col-md-12">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </form>
