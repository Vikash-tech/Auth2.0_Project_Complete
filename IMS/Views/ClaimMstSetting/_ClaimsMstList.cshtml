@model IEnumerable<IMS_Model.SettingModel.IMSClaimMaster>

<table id="tblRoleMstList" class="table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>
                Claim Value
            </th>
            <th>
                Claim Type
            </th>
            <th>
                AddedOn
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ClaimValue)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ClaimType)
                </td>
                <td>
                    @item.AddedOn.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @Html.ActionLink("Edit", "ClaimCreation", new { AddtyId = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { onclick = "return confirm('Are you sure you want to delete this item?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        new DataTable("#tblRoleMstList");
    });
</script>
