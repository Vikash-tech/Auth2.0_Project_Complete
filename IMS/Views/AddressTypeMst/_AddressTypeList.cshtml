@model IEnumerable<IMS_Model.CommonDropDown.AddressType>

<table id="tblAddtypeMstList" class="table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>
                Address Type Description
            </th>
            <th>
                Added On
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.AtDesc)
                </td>
                <td>
                    @item.AddedOn.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @Html.ActionLink("", "AddressTypeIndex", new { AtId = item.AtId }, new { @class = "btnUpdate fa fa-edit" }) 
                    &nbsp;&nbsp;&nbsp;&nbsp;
                    @Html.ActionLink("", "Delete", new { AtId = item.AtId }, new { @class = "btnUpdate fa fa-trash", onclick = "return confirm('Are you sure you want to delete this item?');" })
                </td>

            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        //ButtonsRight();
        new DataTable("#tblAddtypeMstList");
 
    });
</script>
