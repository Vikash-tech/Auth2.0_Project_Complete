@model IMS_Model.CommonDropDown.ViewModel.ViewRoleMaster_VM
<!DOCTYPE html>
<html>
<head>
    <link href="~/css/site.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["Success"]';
            var errorMessage = '@TempData["Error"]';
            if (successMessage != "" && successMessage != null) {
                alert(successMessage);
            } else if (errorMessage !== "" && errorMessage != null) {
                alert(errorMessage);
            }
        });
    </script>
    <style>
        .firstrow {
            margin-top: -15px;
        }

        #tblContainer {
            position: relative;
            overflow: scroll;
            height: 500px;
        }

        #tblClaimsAssign {
            border-collapse: collapse;
            width: 100%;
        }

            #tblClaimsAssign th,
            #tblClaimsAssign td {
                text-align: center;
                padding: 8px;
                border: 1px solid #ddd;
            }

                #tblClaimsAssign th:first-child,
                #tblClaimsAssign td:first-child {
                    text-align: left;
                }

            #tblClaimsAssign th {
                font-size: 12px;
                background-color: #1c78bf;
                color: white;
                height: 5px;
            }

            #tblClaimsAssign input[type="checkbox"] {
                margin-left: 5px;
            }

        #tblheader {
            position: sticky;
            top: 0;
            background-color: #007bff;
            color: #fff;
        }

        input[type="checkbox"]:hover {
            cursor: pointer;
        }

    </style>
</head>
<body>
    <div class="containers-style">
        <form method="post" asp-action="RoleMasterCreation">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h5>Role Master Creation </h5>
                        </div>
                        <div class="col-md-9 text-right">
                            <a type="button" class="btn btn-outline-dark custombtn" href="@Url.Action("Index")" title="Back"><i class="fa fa-backward"></i></a>
                            @if (Model.IMSRoleMaster != null)
                            {
                                @if (Model.IMSRoleMaster.AddedBy != null)
                                {
                                    <button type="submit" id="btnUpdate" class="btn btn-primary custombtn" title="Update"><i class="fa fa-random"></i></button>
                                }
                                else
                                {
                                    <button type="submit" id="btnSave" class="btn btn-success custombtn" title="Save"><i class="fa fa-save"></i></button>
                                }
                            }
                            else
                            {
                                <button type="submit" id="btnSave" class="btn btn-success custombtn" title="Save"><i class="fa fa-save"></i></button>
                            }
                            <button type="submit" class="btn btn-outline-secondary custombtn" asp-action="ReFreshPage" title="Clear Data">
                                <i class="fa fa-refresh"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row firstrow">
                        @if (Model.IMSRoleMaster != null)
                        {
                            <input asp-for="IMSRoleMaster.Id" hidden type="text" class="form-control" />
                            <input asp-for="IMSRoleMaster.AddedBy" hidden type="text" class="form-control" />
                        }
                        <div class="col-md-2 col-sm-2">
                            <span>
                                <label asp-for="IMSRoleMaster.Name" class="control-label"></label>
                                <input asp-for="IMSRoleMaster.Name" type="text" id="txtRoleName" class="form-control" />

                                <span asp-validation-for="IMSRoleMaster.Name" class="text-danger"></span>
                            </span>
                        </div>

                        <div class="col-md-2 col-sm-2">
                            <span>
                                <label asp-for="IMSRoleMaster.NormalizedName" class="control-label"></label>
                                <input asp-for="IMSRoleMaster.NormalizedName" type="text" id="txtRoleNormalizedName" class="form-control" />
                                <span asp-validation-for="IMSRoleMaster.NormalizedName" class="text-danger"></span>
                            </span>
                        </div>

                        <div class="col-md-2 col-sm-2">
                            <span>
                                <label asp-for="IMSRoleMaster.LockPeriod" class="control-label"></label>
                                <input asp-for="IMSRoleMaster.LockPeriod" type="text" id="txtLockPeriod" class="form-control" />
                                <span asp-validation-for="IMSRoleMaster.LockPeriod" class="text-danger"></span>
                            </span>
                        </div>

                        <div class="col-md-2 col-sm-2">
                            <span>
                                <label asp-for="IMSRoleMaster.LockPeriodAdd" class="control-label"></label>
                                <input asp-for="IMSRoleMaster.LockPeriodAdd" type="text" id="txtLockPeriodAdd" class="form-control" />
                                <input hidden asp-for="IMSRoleMaster.ConcurrencyStamp" value="0" type="text" id="txtConcurrencyStamp" class="form-control" />
                                <span asp-validation-for="IMSRoleMaster.LockPeriodAdd" class="text-danger"></span>
                            </span>
                        </div>

                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <input type="text" id="searchBox" placeholder="Menu Search...">
                            <br />    <br />
                            <div id="tblContainer">
                                <table id="tblClaimsAssign" class="table table-bordered table-responsive-md">
                                    <thead id="tblheader">
                                        <tr>
                                            <th hidden>Menu Id</th>
                                            <th style="text-align:start;">Menu Name</th>
                                            @foreach (var claim in Model.IMSClaims)
                                            {
                                                <th>@claim.ClaimType</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody id="tblbody">
                                        @for (var i = 0; i < Model.TMenuMsts.Count; i++)
                                        {
                                            var menuId = Model.TMenuMsts[i].MenuId;
                                            var menuTxt = Model.TMenuMsts[i].MenuTxt;
                                            <tr>
                                                <td hidden>@menuId</td>
                                                <td style="text-align:start;">@menuTxt</td>
                                                @foreach (var claim in Model.IMSClaims)
                                                {
                                                    bool isChecked;
                                                    @if (Model.IMSRoleClaimMasters != null)
                                                    {
                                                        isChecked = Model.IMSRoleClaimMasters.Any(sc => sc.MenuId == menuId && sc.ClaimType == claim.ClaimType);
                                                    }
                                                    else
                                                    {
                                                        isChecked = false;
                                                    }
                                                    <td>
                                                        <input type="checkbox" name="@menuId-@claim.ClaimType-@claim.ClaimValue-true" value="true" @(isChecked ? "checked" : "") />
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>

<script>
    $(document).ready(function () {

        var btnAccvalu = JSON.parse('@Html.Raw(Json.Serialize(ViewBag.btnAccControl))');
        ButtonsRights(btnAccvalu);
    });


    window.onscroll = function () { myFunction() };

    var header = document.getElementById("tblheader");
    var body = document.getElementById("tblbody");
    var sticky = header.offsetTop;

    function myFunction() {
        if (window.pageYOffset > sticky) {
            header.classList.add("sticky");
        } else {
            header.classList.remove("sticky");
        }
    }

    function searchTable() {
        var input, filter, table, tr, td, i, txtValue;

        input = document.getElementById("searchBox");
        filter = input.value.toUpperCase();
        table = document.getElementById("tblClaimsAssign");
        tr = table.getElementsByTagName("tr");

        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[1];
            if (td) {
                txtValue = td.textContent || td.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }

    document.getElementById("searchBox").addEventListener("input", searchTable);

</script>
