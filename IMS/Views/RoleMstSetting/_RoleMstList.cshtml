@model IEnumerable<IMS_Model.SettingModel.IMSRoleMaster>

<table id="tblRoleMstList" class="table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>
                Role Name
            </th>
            <th>
                Normalized Role Name
            </th>
            <th style="text-align:end;">
                Lock Period (In Days)
            </th>
            <th style="text-align:end;">
                Lock Period from Month End
            </th>
            <th style="text-align:center;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NormalizedName)
                </td>
                <td class="end">
                    @Html.DisplayFor(modelItem => item.LockPeriod)
                </td>
                <td class="end">
                    @Html.DisplayFor(modelItem => item.LockPeriodAdd)
                </td>
                <td class="center">
                    @Html.ActionLink("Edit", "GetDatabyId", new { Id = item.Id, EditId = item.Id }, new { @class = "" }) |
                    @Html.ActionLink("Delete", "Delete", new { Id = item.Id }, new { onclick = "return confirm('Are you sure you want to Revoke this item?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
       
        new DataTable("#tblRoleMstList");
    });
</script>
