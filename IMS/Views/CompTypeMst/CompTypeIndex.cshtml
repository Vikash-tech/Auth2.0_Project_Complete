@model IMS_Model.CommonDropDown.CompTypMst
<!DOCTYPE html>
<html>
<head>
    <link href="~/css/site.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["Success"]';
            var errorMessage = '@TempData["Error"]';

            if (successMessage !== "") {
                alert(successMessage);
                window.location.href = "../CompTypeMst/CompTypeIndex";
            } else if (errorMessage !== "") {
                alert(errorMessage);
            }
        });
    </script>
    <style>
        .firstrow {
            margin-top: -15px;
        }
    </style>
</head>
<body>
    <div class="containers-style">
        <form method="post">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h5>Company Type Master Creation </h5>
                        </div>
                        <div class="col-md-9 text-right">
                            <a type="button" class="btn btn-secondary custombtn" asp-action="CompTypeIndex" asp-controller="CompTypeMst" title="Refresh"><i class="fa fa-refresh"></i></a>
                            @* for buttons *@
                            @if (Model != null)
                            {
                                @if (Model.CtmId > 0)
                                {
                                    <button type="submit" class="btnUpdate btn btn-outline-primary custombtn" asp-action="CompTypeIndex" title="Update">
                                        <i class="fa fa-random"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btnAdd btn btn-success custombtn" asp-action="CompTypeIndex" title="Save">
                                        <i class="fa fa-save"></i>
                                    </button>
                                }
                            }
                            else
                            {
                                <button type="submit" class="btnAdd btn btn-success custombtn" asp-action="CompTypeIndex" title="Save">
                                    <i class="fa fa-save"></i>
                                </button>
                            }

                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row firstrow">
                        @if (Model != null)
                        {
                            <input asp-for="CtmId" hidden class="form-control" />
                        }
                        <div class="col-md-3 col-sm-3">
                            <span>
                                <label asp-for="CtmDesc" class="control-label"></label>
                                <input asp-for="CtmDesc" class="form-control" />
                                <span asp-validation-for="CtmDesc" class="text-danger"></span>
                            </span>
                        </div>


                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12" id="PartialCompTypeMst" style="width:100%;">
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>
<script>
    $(document).ready(function () {

        var btnAccvalu = JSON.parse('@Html.Raw(Json.Serialize(ViewBag.btnAccControl))');
        ButtonsRights(btnAccvalu);

        GetCompTypeMstList();
    });

    function GetCompTypeMstList() {

        $.ajax({
            type: 'GET',
            url: '../CompTypeMst/_CompTypMstList',
            data: {},
            cache: false,
            success: function (data) {
                $('#PartialCompTypeMst').html(data);
            },
        });
    }
</script>
