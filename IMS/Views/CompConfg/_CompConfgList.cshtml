@model IEnumerable<IMS_Model.CommonModel.CompConfg>


<table id="tblCompConfMstList" class="JqueryTable table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
 
            <th>
                @Html.DisplayNameFor(model => model.FileName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinStYr)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FinEdYr)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DtFormat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeFormat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumFormat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CurrFormat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActStatus)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FileName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FinStYr)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FinEdYr)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DtFormat)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TimeFormat)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NumFormat)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CurrFormat)
                </td>
                <td style="pointer-events:none">
                    @Html.CheckBoxFor(modelItem => item.ActStatus)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.ConfgId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.ConfgId }, new { onclick = "return confirm('Are you sure you want to delete this item?');" })

                </td>
            </tr>
        }
    </tbody>
</table>


<script>
    $(document).ready(function () {
        JqueryDatatable();
        ButtonsRight();
    });
</script>