<!DOCTYPE html>
<html>
<head>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["Success"]';
            var errorMessage = '@TempData["Error"]';

            if (successMessage !== "" && successMessage != null) {
                alert(successMessage);
            } else if (errorMessage !== "" && errorMessage != null) {
                alert(errorMessage);
            }
        });
    </script>

</head>
<body>
    <div class="containers-style">
        <div class="card custom-card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-3">
                        <h5>Site Master List</h5>
                    </div>
                    <div class="col-md-9 text-right">
                        <a type="button" class="btn btn-secondary custombtn" asp-action="IMSSetting" asp-controller="Login" title="IMS Setting"><i class="fa fa-gear"></i></a>
                        <a href="@Url.Action("SiteCreation")" class="btn btn-success custombtn btnAdd" title="Add">
                            <i class="fa fa-plus"></i>
                        </a>

                        <button type="button" class="btn btn-outline-secondary custombtn" onclick="location.reload();" title="Clear Data">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                </div>

            </div>

            <div class="card-body">
                <div class="row">
                    <div id="PartialSiteMstLst" class="col-md-12"></div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<script>
    $(document).ready(function () {
        var btnAccvalu = JSON.parse('@Html.Raw(Json.Serialize(ViewBag.btnAccControl))');
        ButtonsRights(btnAccvalu);

        GetSiteMstList();
    });

    function GetSiteMstList() {

        $.ajax({
            type: 'POST',
            url: '../SiteMstSetting/_SiteMstList',
            data: {},
            cache: false,
            success: function (data) {
                $('#PartialSiteMstLst').html(data);
            },
        });
    }
</script>






















