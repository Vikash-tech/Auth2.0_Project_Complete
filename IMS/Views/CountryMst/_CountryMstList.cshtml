@model IEnumerable<IMS_Model.CommonDropDown.CountryMst>

<table id="tblCountryMstList" class="table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CtId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CtCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CtName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CtIsdCod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AddedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AddedOn)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CtId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CtCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CtName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CtIsdCod)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AddedBy)
                </td>
                <td>
                    @item.AddedOn.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @Html.ActionLink("", "CountryIndex", new { Ctid = item.CtId },new { @class = "btnUpdate fa fa-edit" })&emsp;&emsp;
                    @Html.ActionLink("", "Delete", new { CtId = item.CtId },new { @class = "btnUpdate fa fa-trash", onclick = "return confirm('Are you sure you want to delete this item?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {


        new DataTable("#tblCountryMstList");

    });
</script>
