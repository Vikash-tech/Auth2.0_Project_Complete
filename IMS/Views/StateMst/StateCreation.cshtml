@model IMS_Model.CommonDropDown.StateMst

<!DOCTYPE html>
<html>
<head>

    <link href="~/css/site.css" rel="stylesheet" />
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["Success"]';
            var errorMessage = '@TempData["Error"]';

            if (successMessage !== "") {
                alert(successMessage);
            } else if (errorMessage !== "") {
                alert(errorMessage);
            }
        });
    </script>
    <style>
        .firstrow {
            margin-top: -15px;
        }
    </style>
</head>
<body>
    <div class="containers-style">
        <form method="post">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-3">
                            <h4>State Master Creation </h4>
                        </div>
                        <div class="col-md-9 text-right">
                            @* for buttons *@
                            <a type="button" class="btn btn-outline-dark custombtn" asp-controller="StateMst" asp-action="Index" title="Back"><i class="fa fa-backward"></i></a>
                            @if (Model != null)
                            {
                                @if (Model.StId > 0)
                                {
                                    <button type="submit" class="btn btn-outline-primary custombtn" asp-action="Edit" title="Update"><i class="fa fa-random"></i></button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-success custombtn" asp-action="StateCreation" title="Save"><i class="fa fa-save"></i></button>
                                }
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success custombtn" asp-action="StateCreation" title="Save"><i class="fa fa-save"></i></button>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row firstrow">
                        <div class="col-md-3 col-sm-3">
                            <span>
                                Country Name
                                <select asp-for="CtId" class="form-control">
                                    <option value="-1">--Select--</option>
                                    @foreach (var item in ViewBag.country)
                                    {
                                        <option value="@item.CtId">@item.CtName</option>
                                    }
                                </select>

                                @if (Model != null)
                                {
                                    <input asp-for="StId" type="hidden" class="form-control form-text" />
                                }
                                <span asp-validation-for="CtId" class="text-danger"></span>
                            </span>
                        </div>

                        <div class="col-md-3 col-sm-3">
                            <span>
                                State Name
                                <input asp-for="StName" class="form-control" />
                                <span asp-validation-for="StName" class="text-danger"></span>
                            </span>
                        </div>


                        <div class="col-md-3 col-sm-3">
                            <span>
                                State Code
                                <input asp-for="StCode" class="form-control" />
                                <span asp-validation-for="StCode" class="text-danger"></span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>

<script>
    $(document).ready(function () {
        var btnAccvalu = JSON.parse('@Html.Raw(Json.Serialize(ViewBag.btnAccControl))');
        ButtonsRights(btnAccvalu);
    });
</script>























