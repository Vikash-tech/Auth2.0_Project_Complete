@model IEnumerable<IMS_Model.CommonDropDown.StateMst>

<table id="tblCompConfMstList" class="JqueryTable table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>State Code</th>
            <th>State Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.StCode)</td>
                <td>@Html.DisplayFor(modelItem => item.StName)</td>
                <td>
                    @Html.ActionLink("", "Edit", new { id = item.StId },new { @class = "btnUpdate fa fa-edit" })&emsp;&emsp;
                    @Html.ActionLink("", "Delete", new { id = item.StId }, new {@class = "btnUpdate fa fa-trash", onclick = "return confirm('Are you sure you want to delete this item?');" })
                </td>
            </tr>
        }
    </tbody>
</table>


<script>
    $(document).ready(function () {
        new DataTable('#tblCompConfMstList', {
            paging: false,
            scrollX: true,
            scrollY: 300
        });  
    });
</script>



















