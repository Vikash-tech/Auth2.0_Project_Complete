@model IMS_Model.CommonDropDown.ViewModel.CompanyMst_VM


<table id="tblCompAddress" class="table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>
                Address Type
            </th>
            <th>
                @Html.DisplayNameFor(model =>  model.CompanyAddress.Add1)
            </th>
            <th>
                @Html.DisplayNameFor(model =>  model.CompanyAddress.Add2)
            </th>
            <th>
                @Html.DisplayNameFor(model =>  model.CompanyAddress.Add3)
            </th>
            <th>
                @Html.DisplayNameFor(model =>  model.CompanyAddress.City)
            </th>
            <th>
                State
            </th>
            <th>
                Country
            </th>
            <th>
                @Html.DisplayNameFor(model =>  model.CompanyAddress.CaPin)
            </th>
            <th>
                @Html.DisplayNameFor(model =>  model.CompanyAddress.Phone)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CompanyAddresslist != null)
        {
            @foreach (var item in Model.CompanyAddresslist.ToList())
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.AtDesc)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Add1)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Add2)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Add3)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.City)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CtName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CaPin)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Phone)
                    </td>
                    <td>
                        <a href="#" class="Edit" data-srno="@item.SRNO" data-addid="@item.CAddId" data-compid="@item.CompId"
                           data-atid="@item.AtId" data-add1="@item.Add1" data-add2="@item.Add2" data-add3="@item.Add3"
                           data-city="@item.City" data-stid="@item.StId" data-ctid="@item.CtId"
                           data-pincode="@item.CaPin" data-phone="@item.Phone">
                            <i class="fa fa-edit"></i>
                        </a> |

                        <a href="#" class="AddDelete" data-srno="@item.SRNO" data-addid="@item.CAddId">
                            <i class="fa fa-eraser"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        let sUserCode = '@ViewBag.sUserCode';
        let iSiteId = '@ViewBag.iSiteId';
        let MenuId = '@ViewBag.MenuId';

        ButtonsRight(sUserCode, iSiteId, MenuId);
        new DataTable("#tblCompAddress");
    });

    //Send data into Textbox
    $(".Edit").click(function () {

        var srno = $(this).data("srno");
        var addid = $(this).data("addid");
        var compid = $(this).data("compid");
        var atid = $(this).data("atid");
        var add1 = $(this).data("add1");
        var add2 = $(this).data("add2");
        var add3 = $(this).data("add3");
        var city = $(this).data("city");
        var stid = $(this).data("stid");
        var ctid = $(this).data("ctid");
        var pincode = $(this).data("pincode");
        var phone = $(this).data("phone");

        $("#txtsrno").val(srno);
        $("#txtAddrssId").val(addid);
        $("#txtCompId").val(compid);
        $("#ddlAddresstyp").val(atid);
        $("#txtAddress1").val(add1);
        $("#txtAddress2").val(add2);
        $("#txtAddress3").val(add3);
        $("#txtCity").val(city);
        $("#ddlState").val(stid);
        $("#ddlCountry").val(ctid);
        $("#txtPinCode").val(pincode);
        $("#txtPhone").val(phone);

        document.getElementById("btnSaveAddrss").disabled = true;
        document.getElementById("btnAddupt").disabled = false;
    });


    $(".AddDelete").click(function () {

        var srno = $(this).data("srno");
        var addid = $(this).data("addid");

        $.ajax({
            type: 'POST',
            url: "../CompanyMst/_CompanyAddressDel",
            data: { SRNO: srno, AddressId: addid },
            success: function (result) {
                $('#PartialAddressType').html(result);
            }
        });


    });
</script>