@model IEnumerable<IMS_Model.CommonDropDown.CompMst>
<!DOCTYPE html>
<html>
<head>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["Success"]';
            var errorMessage = '@TempData["Error"]';
            if (successMessage !== "") {
                alert(successMessage);
            } else if (errorMessage !== "") {
                alert(errorMessage);
            }
        });
    </script>
</head>
<body>
    <div class="containers-style">
        <div class="card custom-card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-3">
                        <h5>Company Master List</h5>
                    </div>
                    <div class="col-md-9 text-right">
                        <a type="button" class="btn btn-secondary custombtn" asp-action="IMSSetting" asp-controller="Login" title="IMS Setting"><i class="fa fa-gear"></i></a>
                        <a href="@Url.Action("CompanyMstCreation")" class="btn btn-success custombtn btnAdd" title="Add">
                            <i class="fa fa-plus"></i>
                        </a>

                        <button type="button" class="btn btn-outline-secondary custombtn" onclick="window.location.reload();" title="Refresh">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12" style="width:100%">
                        <table id="tblCompMstList" class="table-bordered table-responsive-md" style="width:100%">
                            <thead>
                                <tr>
                                    <th>
                                        Comp Code
                                    </th>
                                    <th>
                                        Comp Name
                                    </th>
                                    <th>
                                        Comp Type
                                    </th>
                                    <th>
                                        Comp Pan
                                    </th>
                                    <th>
                                        Comp Cin
                                    </th>
                                    <th>
                                        Comp Url
                                    </th>
                                    <th>
                                        Incor Date
                                    </th>
                                    <th>
                                        Added On
                                    </th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @item.CompCode
                                        </td>
                                        <td>
                                            @item.CompName
                                        </td>
                                        <td>
                                            @item.CtmDesctxt
                                        </td>
                                        <td>
                                            @item.CompPan
                                        </td>
                                        <td>
                                            @item.CompCin
                                        </td>
                                        <td>
                                            @item.CompUrl
                                        </td>
                                        <td>
                                            @item.IncorDt.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @item.AddedOn.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @Html.ActionLink("Edit", "CompanyMstCreation", new { iCompId = item.CompId }) |
                                            @Html.ActionLink("View", "CompanyMstCreation", new { iCompId = item.CompId, iCtmId= item.CtmId}) |
                                            @Html.ActionLink("Delete", "Delete", new { iCompId = item.CompId }, new { onclick = "return confirm('Are you sure you want to delete this item?');" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<script>
    $(document).ready(function () {

        var btnAccvalu = JSON.parse('@Html.Raw(Json.Serialize(ViewBag.btnAccControl))');
        ButtonsRights(btnAccvalu);
        new DataTable("#tblCompMstList");
    });
</script>