@model IEnumerable<IMS_Model.UserMaster.UserDetail>


<table id="tblUserMstList" class="table-bordered table-responsive-md" style="width:100%">
    <thead>
        <tr>
            <th>
                User Code
            </th>
            <th>
                User Name
            </th>
            <th>
                Email Id
            </th>
            <th>
                Phone Number
            </th>
            <th>
                HO User
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    Yes
                </td>
                <td>
                    @Html.ActionLink("Edit", "UserCreation", new { guid = item.Id, EditId = item.Id }, new { @class = "" }) |

                    @Html.ActionLink("Delete", "Delete", new { guid = item.Id }, new { @class = "", onclick = "return confirm('Are you sure you want to delete this item?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        new DataTable("#tblUserMstList");
        ButtonsRight();
    });
</script>
